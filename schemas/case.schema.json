{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:timeframe102:schemas:case:1.7.0",
  "title": "TIMEFRAME/102 scientific case record",
  "description": "Versioned machine-readable record for one real or synthetic astronomical case. The example domain in $id is a stable project identifier, not a data endpoint.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "is_synthetic",
    "time_definition",
    "target",
    "observations",
    "verdict",
    "confirmed_versus_assumed",
    "provenance"
  ],
  "properties": {
    "schema_version": { "const": "1.7.0" },
    "null_field_reasons": {
      "type": "object",
      "description": "Path-keyed reasons for null-valued fields in this exported case. Each key uses a JSON path into this object, excluding null_field_reasons itself.",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "case_id": { "type": "string", "minLength": 1 },
    "is_synthetic": { "type": "boolean" },
    "time_definition": {
      "enum": ["start", "midpoint"],
      "description": "Defines what each observation time_utc represents. Horizons predictions must use epochs with this same definition."
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["asteroid", "star", "comet", "other", "unknown"] },
        "designation": { "type": ["string", "null"] },
        "catalog_id": { "type": ["string", "null"] },
        "coordinates": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["ra_deg", "dec_deg", "frame", "epoch"],
          "properties": {
            "ra_deg": { "type": "number", "minimum": 0, "exclusiveMaximum": 360 },
            "dec_deg": { "type": "number", "minimum": -90, "maximum": 90 },
            "frame": { "type": "string" },
            "epoch": { "type": "string" }
          }
        },
        "proper_motion": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["pm_ra_cosdec_mas_yr", "pm_dec_mas_yr", "reference_epoch"],
          "properties": {
            "pm_ra_cosdec_mas_yr": { "type": ["number", "null"] },
            "pm_dec_mas_yr": { "type": ["number", "null"] },
            "reference_epoch": { "type": ["string", "null"] }
          }
        }
      }
    },
    "observations": {
      "type": "array",
      "items": { "$ref": "#/$defs/observation" }
    },
    "spectral_analysis": {
      "type": ["object", "null"],
      "additionalProperties": false,
        "required": ["model", "parameters", "chi2", "n_observations", "n_parameters", "dof", "reduced_chi2", "chi2_with_floor", "reduced_chi2_with_floor", "chi2_error_model", "per_observation"],
      "properties": {
        "model": { "type": "string" },
        "parameters": {
          "type": "object",
          "description": "Model-specific fit parameters as named numeric values. Convention: a constant-flux model uses flux; a linear_wavelength model uses intercept_flux and slope_flux_per_um. Other model identifiers must document their parameter names and units in model.",
          "additionalProperties": { "type": ["number", "null"] }
        },
        "chi2": { "type": ["number", "null"], "minimum": 0 },
        "n_observations": { "type": ["integer", "null"], "minimum": 0 },
        "n_parameters": { "type": ["integer", "null"], "minimum": 0 },
        "dof": { "type": ["integer", "null"], "minimum": 0 },
        "reduced_chi2": { "type": ["number", "null"], "minimum": 0 },
        "chi2_with_floor": { "type": ["number", "null"], "minimum": 0 },
        "reduced_chi2_with_floor": { "type": ["number", "null"], "minimum": 0 },
        "chi2_error_model": { "type": "string", "minLength": 1 },
        "constant_flux_test": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "statistic", "n_observations", "n_parameters", "dof", "p_value", "reason", "cannot_detect"],
          "properties": {
            "status": { "enum": ["computed", "skipped"] },
            "statistic": { "type": ["number", "null"], "minimum": 0 },
            "n_observations": { "type": ["integer", "null"], "minimum": 0 },
            "n_parameters": { "type": ["integer", "null"], "minimum": 0 },
            "dof": { "type": ["integer", "null"], "minimum": 0 },
            "p_value": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
            "reason": { "type": ["string", "null"] },
            "cannot_detect": { "type": "string", "minLength": 1 }
          }
        },
        "model_curve": {
          "type": "array",
          "description": "Optional model samples as [wavelength_um, flux] pairs.",
          "items": {
            "type": "array",
            "prefixItems": [
              { "type": "number", "exclusiveMinimum": 0 },
              { "type": "number" }
            ],
            "minItems": 2,
            "maxItems": 2
          }
        },
        "per_observation": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["observation_id", "model_flux", "normalized_residual"],
            "properties": {
              "observation_id": { "type": "string", "minLength": 1 },
              "model_flux": { "type": ["number", "null"] },
              "normalized_residual": { "type": ["number", "null"] }
            }
          }
        }
      }
    },
    "spectral_verdict": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["label", "evidence"],
      "properties": {
        "label": { "enum": ["consistent", "inconsistent", "insufficient evidence"] },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["summary", "n_observations", "n_usable", "wavelength_range_um", "reasons"],
          "properties": {
            "summary": { "type": "string" },
            "n_observations": { "type": "integer", "minimum": 0 },
            "n_usable": { "type": "integer", "minimum": 0 },
            "wavelength_range_um": {
              "type": ["array", "null"],
              "prefixItems": [{ "type": "number", "exclusiveMinimum": 0 }, { "type": "number", "exclusiveMinimum": 0 }],
              "minItems": 2,
              "maxItems": 2
            },
            "reasons": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "comparison_star_analysis": { "$ref": "#/$defs/comparisonStarAnalysis" },
    "catalog_flux_comparison": {
      "type": "object",
      "description": "Measured SPHEREx fluxes compared with fluxes interpolated from matched 2MASS/AllWISE magnitudes. Catalog and SPHEREx measurements are preserved without rounding.",
      "additionalProperties": false,
      "required": ["confirmed_catalog_matches", "catalog_flux_points", "comparisons", "assumptions"],
      "properties": {
        "confirmed_catalog_matches": {
          "type": "object",
          "additionalProperties": false,
          "required": ["2mass_designation", "2mass_separation_arcsec", "2mass_ph_qual", "allwise_designation", "allwise_separation_arcsec", "allwise_var_flg", "allwise_ph_qual", "allwise_cc_flags", "allwise_ext_flg"],
          "properties": {
            "2mass_designation": { "type": "string" },
            "2mass_separation_arcsec": { "type": "number", "minimum": 0 },
            "2mass_ph_qual": { "type": "string" },
            "allwise_designation": { "type": "string" },
            "allwise_separation_arcsec": { "type": "number", "minimum": 0 },
            "allwise_var_flg": { "type": "string" },
            "allwise_ph_qual": { "type": "string" },
            "allwise_cc_flags": { "type": "string" },
            "allwise_ext_flg": { "type": "integer" }
          }
        },
        "catalog_flux_points": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["band", "wavelength_um", "flux_jy", "uncertainty_jy", "magnitude", "magnitude_uncertainty", "zero_point_jy", "zero_point_uncertainty_jy"],
            "properties": {
              "band": { "type": "string" },
              "wavelength_um": { "type": "number", "exclusiveMinimum": 0 },
              "flux_jy": { "type": "number", "minimum": 0 },
              "uncertainty_jy": { "type": "number", "minimum": 0 },
              "magnitude": { "type": "number" },
              "magnitude_uncertainty": { "type": "number", "minimum": 0 },
              "zero_point_jy": { "type": "number", "exclusiveMinimum": 0 },
              "zero_point_uncertainty_jy": { "type": ["number", "null"], "minimum": 0 }
            }
          }
        },
        "comparisons": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["observation_id", "wavelength_um", "catalog_interpolation_bands", "catalog_interpolated_flux_jy", "catalog_interpolated_uncertainty_jy", "spherex_flux_jy", "spherex_uncertainty_jy", "flux_ratio_spherex_to_catalog", "flux_ratio_uncertainty"],
            "properties": {
              "observation_id": { "type": "string" },
              "wavelength_um": { "type": "number", "exclusiveMinimum": 0 },
              "catalog_interpolation_bands": { "type": "array", "items": { "type": "string" } },
              "catalog_interpolated_flux_jy": { "type": "number" },
              "catalog_interpolated_uncertainty_jy": { "type": "number", "minimum": 0 },
              "spherex_flux_jy": { "type": "number" },
              "spherex_uncertainty_jy": { "type": "number", "minimum": 0 },
              "flux_ratio_spherex_to_catalog": { "type": "number", "exclusiveMinimum": 0 },
              "flux_ratio_uncertainty": { "type": "number", "minimum": 0 }
            }
          }
        },
        "assumptions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "dr1_calibration_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "product", "reason", "comparison"],
      "properties": {
        "status": { "enum": ["pass", "fail", "not applicable"] },
        "product": { "type": "string" },
        "reason": { "type": "string" },
        "comparison": { "type": ["object", "null"] }
      }
    },
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "evidence", "threshold_policy"],
      "properties": {
        "label": { "enum": ["moving", "no significant motion detected", "insufficient evidence"] },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["summary", "n_observations", "n_usable", "baseline_days"],
          "properties": {
            "summary": { "type": "string" },
            "n_observations": { "type": "integer", "minimum": 0 },
            "n_usable": { "type": "integer", "minimum": 0 },
            "baseline_days": { "type": ["number", "null"], "minimum": 0 },
            "residual_rms_arcsec": { "type": ["number", "null"], "minimum": 0 },
            "motion_significance_sigma": { "type": ["number", "null"], "minimum": 0 },
            "reasons": { "type": "array", "items": { "type": "string" } }
          }
        },
        "threshold_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id", "minimum_usable_epochs", "moving_significance_sigma",
            "minimum_displacement_uncertainty_ratio", "no_motion_confidence_level",
            "no_motion_max_displacement_arcsec", "quality_flags_exclude",
            "context_only_flags", "mad_residual_threshold_sigma", "spectral_fit_model",
            "wavelength_bin_width_um", "minimum_comparison_stars", "minimum_floor_epochs",
            "comparison_star_criteria"
          ],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "minimum_usable_epochs": { "type": "integer", "minimum": 1 },
            "moving_significance_sigma": { "type": "number", "exclusiveMinimum": 0 },
            "minimum_displacement_uncertainty_ratio": { "type": "number", "exclusiveMinimum": 0 },
            "no_motion_confidence_level": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
            "no_motion_max_displacement_arcsec": { "type": ["number", "null"], "exclusiveMinimum": 0 },
            "quality_flags_exclude": {
              "type": "array", "uniqueItems": true,
              "items": { "enum": ["TRANSIENT", "SUR_ERROR", "NONFUNC", "OVERFLOW", "SATURATED"] }
            },
            "context_only_flags": {
              "type": "array", "uniqueItems": true,
              "items": { "enum": ["HALO", "PERSIST", "DICHROIC"] },
              "description": "Recorded but not independently excluded; these flags require source-aperture impact evidence."
            },
            "mad_residual_threshold_sigma": { "type": "number", "exclusiveMinimum": 0 },
            "spectral_fit_model": { "type": "string", "minLength": 1 },
            "wavelength_bin_width_um": { "type": "number", "exclusiveMinimum": 0 },
            "minimum_comparison_stars": { "type": "integer", "minimum": 1 },
            "minimum_floor_epochs": { "type": "integer", "minimum": 2 },
            "comparison_star_criteria": {
              "type": "object",
              "additionalProperties": false,
              "required": ["catalogs", "gaia_g_mag_range", "two_mass_match_max_arcsec", "two_mass_ph_qual",
                "allwise_match_max_arcsec", "allwise_ph_qual_w1_w2", "allwise_cc_flags_w1_w2",
                "allwise_ext_flg", "gaia_isolation_radius_arcsec", "maximum_total_proper_motion_mas_yr",
                "maximum_ruwe", "exclude_phot_variable_flag", "allowed_phot_variable_flag_values",
                "minimum_cutout_edge_margin_arcsec", "exclude_hard_source_flags", "minimum_stars_per_frame",
                "maximum_stars_per_frame", "aperture_radius_px", "annulus_inner_px", "annulus_outer_px",
                "photometric_floor_method", "astrometric_threshold_method"],
              "properties": {
                "catalogs": { "type": "array", "items": { "type": "string" }, "minItems": 2 },
                "gaia_g_mag_range": { "type": "array", "prefixItems": [{"type":"number"},{"type":"number"}], "minItems": 2, "maxItems": 2 },
                "two_mass_match_max_arcsec": { "type": "number", "exclusiveMinimum": 0 },
                "two_mass_ph_qual": { "type": "string" },
                "allwise_match_max_arcsec": { "type": "number", "exclusiveMinimum": 0 },
                "allwise_ph_qual_w1_w2": { "type": "string" },
                "allwise_cc_flags_w1_w2": { "type": "string" },
                "allwise_ext_flg": { "type": "integer", "minimum": 0 },
                "gaia_isolation_radius_arcsec": { "type": "number", "exclusiveMinimum": 0 },
                "maximum_total_proper_motion_mas_yr": { "type": "number", "exclusiveMinimum": 0 },
                "maximum_ruwe": { "type": "number", "exclusiveMinimum": 0 },
                "exclude_phot_variable_flag": { "type": "boolean" },
                "allowed_phot_variable_flag_values": { "type": "array", "items": {"type":"string"}, "minItems": 1 },
                "minimum_cutout_edge_margin_arcsec": { "type": "number", "minimum": 0 },
                "exclude_hard_source_flags": { "type": "array", "items": {"type":"string"}, "uniqueItems": true },
                "minimum_stars_per_frame": { "type": "integer", "minimum": 1 },
                "maximum_stars_per_frame": { "type": "integer", "minimum": 1 },
                "aperture_radius_px": { "type": "number", "exclusiveMinimum": 0 },
                "annulus_inner_px": { "type": "number", "exclusiveMinimum": 0 },
                "annulus_outer_px": { "type": "number", "exclusiveMinimum": 0 },
                "photometric_floor_method": { "type": "string", "minLength": 1 },
                "astrometric_threshold_method": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "confirmed_versus_assumed": {
      "type": "object",
      "description": "Separate verified measurements and archive metadata from assumptions or unresolved values.",
      "additionalProperties": false,
      "required": ["confirmed", "assumed", "unverified"],
      "properties": {
        "confirmed": { "type": "array", "items": { "type": "string" } },
        "assumed": { "type": "array", "items": { "type": "string" } },
        "unverified": { "type": "array", "items": { "type": "string" } }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["products", "software"],
      "properties": {
        "products": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["archive", "product_id", "product_type"],
            "properties": {
              "archive": { "type": "string" },
              "product_id": { "type": "string", "minLength": 1 },
              "product_type": { "type": "string", "minLength": 1 },
              "release": { "type": ["string", "null"] },
              "access_url": { "type": ["string", "null"], "format": "uri" },
              "retrieved_utc": { "type": ["string", "null"], "format": "date-time" },
              "sha256": { "type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$" }
            }
          }
        },
        "software": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pipeline_version", "environment_lock"],
          "properties": {
            "pipeline_version": { "type": "string" },
            "environment_lock": { "type": "string" },
            "git_commit": { "type": ["string", "null"] }
          }
        },
        "horizons": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["service", "target", "reference_frame", "epoch_scale", "light_time_correction", "observer_location", "spacecraft_minus_geocenter_arcsec"],
          "properties": {
            "service": { "type": "string" },
            "target": { "type": "string" },
            "reference_frame": { "type": "string" },
            "epoch_scale": { "type": "string" },
            "light_time_correction": { "type": "string" },
            "observer_location": { "type": "string" },
            "spacecraft_minus_geocenter_arcsec": { "type": ["number", "null"], "minimum": 0 }
          }
        }
      }
    },
    "image_preview": {
      "type": ["object", "null"],
      "deprecated": true,
      "description": "Deprecated in schema 1.2.0. Use observations[].image. Image paths are relative to the containing case JSON file.",
      "additionalProperties": false,
      "required": ["path", "width_px", "height_px", "stretch"],
      "properties": {
        "path": { "type": "string" },
        "width_px": { "type": "integer", "minimum": 1, "maximum": 512 },
        "height_px": { "type": "integer", "minimum": 1, "maximum": 512 },
        "stretch": { "type": "string" }
      }
    }
  },
  "$defs": {
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_id", "time_utc", "ra_deg", "dec_deg", "detector",
        "effective_wavelength_um", "wavelength_width_um", "quality_flags", "measured_position",
        "predicted_position", "flux", "usable", "metadata_status", "image", "registration"
      ],
      "allOf": [
        {
          "if": { "properties": { "usable": { "const": false } }, "required": ["usable"] },
          "then": { "required": ["exclusion_reason"] }
        }
      ],
      "properties": {
        "observation_id": { "type": "string", "minLength": 1 },
        "time_utc": {
          "type": "string",
          "format": "date-time",
          "description": "UTC timestamp interpreted using the case-level time_definition; matching Horizons epochs must use this same instant."
        },
        "ra_deg": { "type": ["number", "null"], "minimum": 0, "exclusiveMaximum": 360 },
        "dec_deg": { "type": ["number", "null"], "minimum": -90, "maximum": 90 },
        "detector": { "type": ["integer", "null"], "minimum": 1, "maximum": 6 },
        "effective_wavelength_um": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0,
          "description": "Effective wavelength from the nearest EPSF detector zone (CWAVE); WCS-WAVE is also sampled as a cross-check. The source pixel and wavelength source are recorded below."
        },
        "wavelength_width_um": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "wavelength_uncertainty_um": {
          "type": ["number", "null"],
          "minimum": 0,
          "description": "Absolute difference between EPSF.CWAVE and the WCS-WAVE lookup at the source position; a cross-product discrepancy estimate, not a calibrated 1-sigma uncertainty."
        },
        "wavelength_source": { "type": ["string", "null"] },
        "wavelength_pixel_xy": {
          "type": ["array", "null"],
          "description": "Zero-based [x,y] pixel position in the original detector image at which EPSF and WCS-WAVE were sampled, before reprojection.",
          "prefixItems": [{ "type": "number" }, { "type": "number" }],
          "minItems": 2,
          "maxItems": 2
        },
        "wavelength_sample_basis": {
          "enum": ["measured_source_centroid", "predicted_position_unresolved"],
          "description": "Identifies whether wavelength was sampled at an associated measured centroid or at the prediction because source association was unresolved."
        },
        "quality_flags": {
          "type": "object",
          "additionalProperties": false,
          "required": ["raw_value", "flag_names", "accepted_for_science"],
          "properties": {
            "raw_value": { "type": ["integer", "null"], "minimum": 0 },
            "flag_names": { "type": "array", "items": { "type": "string" } },
            "accepted_for_science": { "type": "boolean" },
            "variance_value": { "type": ["number", "null"], "minimum": 0 },
            "variance_unit": { "type": ["string", "null"] }
          }
        },
        "measured_position": { "$ref": "#/$defs/position" },
        "predicted_position": {
          "oneOf": [{ "$ref": "#/$defs/position" }, { "type": "null" }]
        },
        "position_residual_arcsec": {
          "type": ["array", "null"],
          "prefixItems": [{ "type": "number" }, { "type": "number" }],
          "minItems": 2,
          "maxItems": 2,
          "description": "East and north tangent-plane residuals, in arcseconds."
        },
        "flux": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "uncertainty", "unit"],
          "properties": {
            "value": { "type": ["number", "null"] },
            "uncertainty": { "type": ["number", "null"], "minimum": 0 },
            "unit": { "type": "string" },
            "method": { "type": ["string", "null"] }
          }
        },
        "image": {
          "description": "Image path is relative to the containing case JSON file. Each cutout is reprojected onto the shared north-up TAN grid convention: 128x128 pixels at 6 arcsec/pixel by default, ICRS, zero rotation, x increases west and y increases north. The TAN center may differ by epoch so the predicted target remains within the cutout. source_xy is the measured source position; predicted_xy is the Horizons-predicted position, both in zero-based [x,y] pixel coordinates on this grid.",
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "width_px", "height_px", "stretch", "pixel_scale_arcsec", "source_xy", "predicted_xy"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "width_px": { "type": "integer", "minimum": 1, "maximum": 512 },
                "height_px": { "type": "integer", "minimum": 1, "maximum": 512 },
                "stretch": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["type", "vmin", "vmax"],
                  "properties": {
                    "type": { "type": "string", "minLength": 1 },
                    "vmin": { "type": "number" },
                    "vmax": { "type": "number" }
                  }
                },
                "pixel_scale_arcsec": { "type": "number", "exclusiveMinimum": 0 },
                "source_xy": {
                  "type": ["array", "null"],
                  "description": "Measured source position on the common grid; null if no reliable centroid was measured.",
                  "prefixItems": [{ "type": "number" }, { "type": "number" }],
                  "minItems": 2,
                  "maxItems": 2
                },
                "predicted_xy": {
                  "type": ["array", "null"],
                  "description": "Horizons-predicted pixel position in the cutout, in [x, y] order; null when unavailable.",
                  "prefixItems": [{ "type": "number" }, { "type": "number" }],
                  "minItems": 2,
                  "maxItems": 2
                }
              }
            },
            { "type": "null" }
          ]
        },
        "registration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["n_reference_stars", "rms_arcsec", "method"],
          "properties": {
            "n_reference_stars": { "type": ["integer", "null"], "minimum": 0 },
            "rms_arcsec": { "type": ["number", "null"], "minimum": 0 },
            "method": { "type": "string", "minLength": 1 }
          }
        },
        "usable": { "type": "boolean" },
        "exclusion_reason": { "type": "string", "minLength": 1 },
        "metadata_status": { "enum": ["confirmed", "assumed", "unverified", "missing"] }
      }
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ra_deg", "dec_deg", "uncertainty_ra_arcsec", "uncertainty_dec_arcsec", "method"],
      "properties": {
        "ra_deg": { "type": ["number", "null"], "minimum": 0, "exclusiveMaximum": 360 },
        "dec_deg": { "type": ["number", "null"], "minimum": -90, "maximum": 90 },
        "uncertainty_ra_arcsec": { "type": ["number", "null"], "minimum": 0 },
        "uncertainty_dec_arcsec": { "type": ["number", "null"], "minimum": 0 },
        "method": { "type": "string" }
      }
    },
    "comparisonStarAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selection_status", "selection_reason", "n_gaia_candidates", "gaia_candidate_source_ids", "n_catalog_matched", "n_stars_used", "stars_used", "per_frame_counts", "photometric_floor", "astrometric_calibration"],
      "properties": {
        "catalog_query": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "catalog_source", "query_utc", "servers", "row_counts"],
          "properties": {
            "status": { "enum": ["complete", "failed", "not run"] },
            "catalog_source": { "type": "string" },
            "query_utc": { "type": ["string", "null"], "format": "date-time" },
            "servers": { "type": "object", "additionalProperties": { "type": "string" } },
            "row_counts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
            "reason": { "type": ["string", "null"] }
          }
        },
        "catalog_matched_candidate_source_ids": { "type": "array", "items": { "type": "string" } },
        "selection_status": { "enum": ["measured", "insufficient stars", "blocked", "not run"] },
        "selection_reason": { "type": ["string", "null"] },
        "n_gaia_candidates": { "type": ["integer", "null"], "minimum": 0 },
        "gaia_candidate_source_ids": { "type": "array", "items": { "type": "string" } },
        "n_catalog_matched": { "type": ["integer", "null"], "minimum": 0 },
        "n_stars_used": { "type": "integer", "minimum": 0 },
        "stars_used": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["source_id", "ra_deg", "dec_deg", "g_mag", "pm_total_mas_yr", "ruwe", "phot_variable_flag", "two_mass_designation", "allwise_designation"],
            "properties": {
              "source_id": { "type": "string" },
              "ra_deg": { "type": "number", "minimum": 0, "exclusiveMaximum": 360 },
              "dec_deg": { "type": "number", "minimum": -90, "maximum": 90 },
              "g_mag": { "type": "number" },
              "pm_total_mas_yr": { "type": "number", "minimum": 0 },
              "ruwe": { "type": "number", "exclusiveMinimum": 0 },
              "phot_variable_flag": { "type": ["string", "null"] },
              "two_mass_designation": { "type": "string" },
              "allwise_designation": { "type": "string" }
            }
          }
        },
        "per_frame_counts": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["observation_id", "detector", "n_stars", "reason"],
            "properties": {
              "observation_id": { "type": "string" },
              "detector": { "type": "integer", "minimum": 1, "maximum": 6 },
              "n_stars": { "type": ["integer", "null"], "minimum": 0 },
              "reason": { "type": ["string", "null"] },
              "n_catalog_matched": { "type": ["integer", "null"], "minimum": 0 },
              "n_inside_cutout": { "type": ["integer", "null"], "minimum": 0 },
              "n_edge_safe": { "type": ["integer", "null"], "minimum": 0 },
              "n_hard_flagged": { "type": ["integer", "null"], "minimum": 0 },
              "prephotometry_candidate_source_ids": { "type": "array", "items": { "type": "string" } },
              "hard_flagged_source_ids": {
                "type": "array",
                "items": {
                  "type": "object", "additionalProperties": false,
                  "required": ["source_id", "flag_names"],
                  "properties": {
                    "source_id": { "type": "string" },
                    "flag_names": { "type": "array", "items": { "type": "string" } }
                  }
                }
              }
            }
          }
        },
        "photometric_floor": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "method", "sample_size", "fractional_scatter", "floor_jy", "reason"],
          "properties": {
            "status": { "enum": ["measured", "insufficient sample", "unavailable"] },
            "method": { "type": "string" },
            "sample_size": { "type": "integer", "minimum": 0 },
            "fractional_scatter": { "type": ["number", "null"], "minimum": 0 },
            "floor_jy": { "type": ["number", "null"], "minimum": 0 },
            "reason": { "type": ["string", "null"] }
          }
        },
        "astrometric_calibration": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "method", "n_star_measurements", "common_offset_east_arcsec", "common_offset_north_arcsec", "residual_scatter_arcsec", "displacement_threshold_arcsec", "reason"],
          "properties": {
            "status": { "enum": ["measured", "insufficient sample", "unavailable"] },
            "method": { "type": "string" },
            "n_star_measurements": { "type": "integer", "minimum": 0 },
            "common_offset_east_arcsec": { "type": ["number", "null"] },
            "common_offset_north_arcsec": { "type": ["number", "null"] },
            "residual_scatter_arcsec": { "type": ["number", "null"], "minimum": 0 },
            "displacement_threshold_arcsec": { "type": ["number", "null"], "minimum": 0 },
            "reason": { "type": ["string", "null"] }
          }
        }
      }
    }
  }
}
