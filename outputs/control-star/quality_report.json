{
  "policy": {
    "id": "control-star-quality-and-spectral-policy-1",
    "quality_flags_exclude": [
      "TRANSIENT",
      "SUR_ERROR",
      "NONFUNC",
      "OVERFLOW",
      "SATURATED"
    ],
